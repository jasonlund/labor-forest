#!/usr/bin/env bash

set -e

BASE_DIR="$HOME/.laborforest"
PENDING_FILE="$BASE_DIR/pending.yaml"
SETTINGS_FILE="$BASE_DIR/settings.yaml"

# YAML single-quoted scalar; embedded quotes are doubled per the spec.
yaml_quote() {
    local quote="'"

    printf '%s%s%s' "$quote" "${1//$quote/$quote$quote}" "$quote"
}

# The deeplink only wakes and focuses the app; this file is the request it reads.
write_pending() {
    local command="$1"
    local workflow="${2-}"

    mkdir -p "$BASE_DIR"

    {
        printf 'command: %s\n' "$(yaml_quote "$command")"
        printf 'path: %s\n' "$(yaml_quote "$PWD")"

        if [[ -n "$workflow" ]]; then
            printf 'workflow: %s\n' "$(yaml_quote "$workflow")"
        fi
    } > "$PENDING_FILE"
}

# Wake the app on the deeplink. Nothing but the app's own settings file says whether the user
# wants it to come forward, and `open` decides that before any PHP runs, so the setting is read
# here too: -g launches or wakes the app without activating it, leaving the terminal in front.
# A file that is missing, or has no such key, reads as the visible default.
wake_app() {
    if [[ -f "$SETTINGS_FILE" ]] && grep -qE '^headless:[[:space:]]+true[[:space:]]*$' "$SETTINGS_FILE"; then
        open -g "$1"
    else
        open "$1"
    fi
}

usage() {
    cat <<'EOF'
💪🌲 LaborForest CLI tools

Usage:  lf add-project
        lf run <workflow>
        lf validate <workflow>
        lf --help
EOF
}

# Exit unless the named workflow file exists in the current directory's workspace.
require_workflow_file() {
    local workflow="$1"

    if [[ -z "$workflow" ]]; then
        usage
        exit 0
    fi

    # both spellings of the extension are accepted, matching the app; the message names the
    # `.yaml` form because that is the one the app itself writes
    if [[ ! -f ".laborforest/workflows/${workflow}.yaml" && ! -f ".laborforest/workflows/${workflow}.yml" ]]; then
        printf 'File not found: .laborforest/workflows/%s.yaml\n' "$workflow" >&2
        exit 1
    fi
}

add_project() {
    echo "Adding current directory as LaborForest project"

    write_pending "add-project"

    wake_app "laborforest://add-project"
}

run_workflow() {
    local workflow="$1"

    require_workflow_file "$workflow"

    echo "Running workflow: ${workflow}"

    write_pending "run-workflow" "$workflow"

    wake_app "laborforest://run-workflow"
}

validate_workflow() {
    local workflow="$1"

    require_workflow_file "$workflow"

    echo "Validating workflow: ${workflow}"

    write_pending "validate-workflow" "$workflow"

    wake_app "laborforest://validate-workflow"
}

case "${1-}" in
    add-project) add_project ;;
    run) run_workflow "${2-}" ;;
    validate) validate_workflow "${2-}" ;;
    --help|'') usage ;;
    *) printf 'Unknown command; see `lf --help`\n' >&2; exit 1 ;;
esac
